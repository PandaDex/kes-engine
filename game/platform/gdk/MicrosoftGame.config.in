<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by CMake from game/platform/gdk/MicrosoftGame.config.in.
     Edit the template (or the KES_GDK_* / KES_PROJECT_* cache variables), not the copy next to the exe.
     Reference: https://aka.ms/GDK_MSGC -->
<Game configVersion="1">

  <Identity Name="@KES_GDK_IDENTITY_NAME@"
    Publisher="@KES_GDK_PUBLISHER@"
    Version="@KES_PROJECT_VERSION@" />

  <ExecutableList>
    <Executable Name="@KES_GDK_EXECUTABLE@"
      Id="Game"
      TargetDeviceFamily="PC" />
  </ExecutableList>

  <ShellVisuals DefaultDisplayName="@KES_PROJECT_NAME@"
    PublisherDisplayName="@KES_PROJECT_PUBLISHER@"
    Square480x480Logo="Square480x480Logo.png"
    Square150x150Logo="Square150x150Logo.png"
    Square44x44Logo="Square44x44Logo.png"
    Description="@KES_PROJECT_NAME@"
    ForegroundText="light"
    BackgroundColor="#141428"
    SplashScreenImage="SplashScreen.png"
    StoreLogo="StoreLogo.png" />

  <!-- Placeholders are accepted for local builds; set the real values from
       Partner Center (KES_GDK_MSA_APP_ID / KES_GDK_TITLE_ID) before submission. -->
  <MSAAppId>@KES_GDK_MSA_APP_ID@</MSAAppId>
  <TitleId>@KES_GDK_TITLE_ID@</TitleId>

  <DesktopRegistration>
    <ProcessorArchitecture>x64</ProcessorArchitecture>
    <!-- MSVC runtime (the engine links /MD); installed with the package. -->
    <DependencyList>
      <KnownDependency Name="VC14" />
    </DependencyList>
  </DesktopRegistration>

</Game>