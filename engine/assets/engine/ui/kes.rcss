/*
 * KES default UI style sheet.
 *
 * RmlUi has no built-in browser defaults: every element starts out inline and
 * unstyled. Link this sheet first in a document to get HTML-like behaviour:
 *
 *   <link type="text/rcss" href="/engine/ui/kes.rcss"/>
 *
 * Units: px are backbuffer pixels; dp are scaled by the window display scale.
 * Font: "LatoLatin" (engine/ui/fonts), regular / bold / italic / bold italic.
 */

body
{
    display: block;
    width: 100%;
    height: 100%;
    font-family: LatoLatin;
    font-size: 16dp;
    font-weight: normal;
    font-style: normal;
    color: #e8e8e8;
}

/* Block elements */
div, p, h1, h2, h3, h4, h5, h6, header, footer, main, nav, section, article,
aside, form, ul, ol, li, dl, dt, dd, blockquote, pre, hr, figure, figcaption
{
    display: block;
}

h1 { font-size: 2em;    font-weight: bold; margin: 0.67em 0; }
h2 { font-size: 1.5em;  font-weight: bold; margin: 0.75em 0; }
h3 { font-size: 1.17em; font-weight: bold; margin: 0.83em 0; }
h4 { font-weight: bold; margin: 1em 0; }
h5 { font-size: 0.83em; font-weight: bold; margin: 1.2em 0; }
h6 { font-size: 0.67em; font-weight: bold; margin: 1.5em 0; }
p  { margin: 1em 0; }
ul, ol { padding-left: 1.5em; margin: 0.5em 0; }
blockquote { margin: 1em 2em; }
pre { white-space: pre; }
hr { height: 1dp; margin: 0.5em 0; background-color: #ffffff40; }

/* Inline text */
strong, b { font-weight: bold; }
em, i { font-style: italic; }

/* Tables */
table    { box-sizing: border-box; display: table; }
tr       { box-sizing: border-box; display: table-row; }
td, th   { box-sizing: border-box; display: table-cell; padding: 2dp 6dp; }
th       { font-weight: bold; }
col      { box-sizing: border-box; display: table-column; }
colgroup { display: table-column-group; }
thead, tbody, tfoot { display: table-row-group; }

/* Form controls */
button, input.submit, input.button
{
    display: inline-block;
    padding: 6dp 14dp;
    background-color: #2b2f3a;
    border: 1dp #5a6070;
    border-radius: 3dp;
    color: #f0f0f0;
    text-align: center;
    cursor: pointer;
    tab-index: auto;
    nav: auto;
}
button:hover, input.submit:hover, input.button:hover { background-color: #3a4050; }
button:active, input.submit:active, input.button:active { background-color: #222631; }
button:focus-visible, input:focus-visible, select:focus-visible { border-color: #e0a040; }
button:disabled, input:disabled, select:disabled { color: #ffffff60; cursor: unavailable; }

input.text, input.password, textarea
{
    display: inline-block;
    box-sizing: border-box;
    padding: 4dp 6dp;
    background-color: #12141a;
    border: 1dp #5a6070;
    color: #f0f0f0;
    cursor: text;
    tab-index: auto;
    nav: auto;
}
input.text, input.password { width: 200dp; }
textarea { width: 300dp; height: 80dp; }

input.checkbox, input.radio
{
    display: inline-block;
    width: 14dp;
    height: 14dp;
    margin-right: 4dp;
    vertical-align: middle;
    background-color: #12141a;
    border: 1dp #5a6070;
    cursor: pointer;
    tab-index: auto;
    nav: auto;
}
input.radio { border-radius: 7dp; }
input.checkbox:checked, input.radio:checked { background-color: #e0a040; }

input.range { display: inline-block; width: 160dp; height: 14dp; tab-index: auto; nav: auto; }
input.range slidertrack { margin-top: 6dp; height: 2dp; background-color: #5a6070; }
input.range sliderbar { width: 10dp; height: 14dp; background-color: #e0e0e0; border-radius: 2dp; }
input.range sliderbar:hover { background-color: #ffffff; }
input.range sliderarrowdec, input.range sliderarrowinc { width: 0; }

select
{
    display: inline-block;
    width: 200dp;
    height: 26dp;
    background-color: #12141a;
    border: 1dp #5a6070;
    tab-index: auto;
    nav: auto;
}
select selectvalue { padding: 4dp 6dp; }
select selectarrow { width: 20dp; height: 24dp; background-color: #2b2f3a; }
select selectbox { background-color: #1b1e26; border: 1dp #5a6070; padding: 2dp 0; }
select selectbox option { padding: 3dp 6dp; }
select selectbox option:hover { background-color: #3a4050; }

/* Scrollbars (overflow: auto / scroll) */
scrollbarvertical { width: 10dp; margin-right: 2dp; }
scrollbarvertical slidertrack { background-color: #00000040; }
scrollbarvertical sliderbar { background-color: #ffffff50; border-radius: 4dp; }
scrollbarvertical sliderbar:hover { background-color: #ffffff80; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; }
scrollbarhorizontal { height: 10dp; }
scrollbarhorizontal slidertrack { background-color: #00000040; }
scrollbarhorizontal sliderbar { background-color: #ffffff50; border-radius: 4dp; }
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0; }
