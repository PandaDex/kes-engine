<rml>
<head>
    <title>Loading</title>
    <link type="text/rcss" href="/engine/ui/kes.rcss"/>
    <link type="text/rcss" href="showcase.rcss"/>
</head>
<!-- Loading screen: rotating rings (transform keyframes), a bar whose width is bound with data-style-width. -->
<body id="loading" class="loading" data-model="game">
    <div class="loading-center">
        <div class="spinner">
            <div class="ring"/>
            <div class="ring inner"/>
        </div>
        <div class="loading-title">DEPLOYING TO LEVEL</div>
        <div class="bar loading-bar"><div class="fill" data-style-width="load_pct + '%'"/></div>
        <div class="loading-pct">{{ load_pct }}%  ·  {{ load_stage }}</div>
    </div>
    <div class="loading-tip"><span class="label">TIP</span>{{ load_tip }}</div>
</body>
</rml>
